# Copy to .env for local work. In Vercel, add the same names under Project Settings > Environment Variables.
# Never commit real values.

# --- Site (Vercel + local) ---

# Required for the generated share cards (Open Graph images). Card URLs are signed with it; without it /_og/* answers
# 500 (pages still render). 32+ characters: `npx nuxt-og-image generate-secret`. Use the same value on staging and
# production so cached card URLs stay valid.
NUXT_APP_SECRET=

# Optional. Defaults to the staff Directus below. Set only to point an environment at a different instance.
# NUXT_PUBLIC_DIRECTUS_URL=https://manage.southerntier8.org
# DIRECTUS_URL=https://manage.southerntier8.org

# Optional. The public ST8 Google Calendar read key is built in as the default; set to replace it.
# NUXT_GOOGLE_CALENDAR_KEY=

# Optional. Ask ST8, the short AI answer above search results (Claude Haiku 5.5). Unset, /api/ask reports itself off and
# search shows its ordinary results only. Server-only: read at request time, never sent to the browser. Set a monthly
# spending limit on the API account too. Staff can also turn the answers off in Directus (Organization → Ask ST8).
# ANTHROPIC_API_KEY=

# --- Scripts only (scripts/, run from your machine; never set in Vercel) ---

# Admin token for the Directus setup and type-generation scripts.
# DIRECTUS_TOKEN=
# Role id that staff accounts use, for the schema scripts that set permissions.
# DIRECTUS_STAFF_ROLE=

# Preview only: the origin share cards are built on (set on the preview deployment, not on production).
# Unset, it defaults to https://southerntier8.org. og:url always stays on the live host.
# NUXT_PUBLIC_SITE_URL=https://staging.southerntier8.org
